[Unit]
Description=Reconcile wiki GitHub and verify GitHub Pages synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/goyoonjung-wiki
ExecStart=%h/goyoonjung-wiki/.venv/bin/python scripts/publish_website_content.py
Environment=TZ=Asia/Seoul
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=1500
SuccessExitStatus=75
