[Unit]
Description=Reconcile wiki GitHub and verify GitHub Pages synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/goyoonjung-runtime/goyoonjung-wiki
ExecStart=/usr/bin/env bash scripts/run_fast_sync.sh
Environment=TZ=Asia/Seoul
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=900
SuccessExitStatus=75
