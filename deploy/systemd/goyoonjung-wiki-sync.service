[Unit]
Description=Reconcile wiki GitHub and verify GitHub Pages synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/goyoonjung-wiki
ExecStart=%h/goyoonjung-wiki/.venv/bin/python scripts/automation_tick.py
Environment=TZ=Asia/Seoul
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=4200
SuccessExitStatus=75
