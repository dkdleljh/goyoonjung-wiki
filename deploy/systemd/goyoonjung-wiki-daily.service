[Unit]
Description=goyoonjung-wiki collection and GitHub Pages content sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/goyoonjung-wiki
ExecStart=/usr/bin/env bash scripts/collect_and_sync_website.sh
Environment=COLLECT_ONLY=1
Environment=TZ=Asia/Seoul
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=4200
SuccessExitStatus=75

[Install]
WantedBy=default.target
